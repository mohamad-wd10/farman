# Django Settings
FARMAN_SECRET_KEY=your-super-secret-key-change-this-in-production
FARMAN_DEBUG=False
FARMAN_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database (PostgreSQL)
FARMAN_DB_NAME=farman_db
FARMAN_DB_USER=farman_user
FARMAN_DB_PASSWORD=your-db-password
FARMAN_DB_HOST=localhost
FARMAN_DB_PORT=5432

# Redis
FARMAN_REDIS_URL=redis://localhost:6379/1
FARMAN_CELERY_BROKER=redis://localhost:6379/0
FARMAN_CELERY_BACKEND=redis://localhost:6379/0

# AI Engine (OpenAI)
FARMAN_AI_PROVIDER=openai
FARMAN_AI_MODEL=gpt-4o-mini
FARMAN_AI_API_KEY=sk-your-openai-api-key

# CORS
FARMAN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com

# Telegram Bot (Optional)
FARMAN_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
FARMAN_TELEGRAM_ADMIN_ID=your-telegram-admin-id

# Sentry (Optional Monitoring)
FARMAN_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
